		"@types/eslint": "^8.56.0",
		"eslint": "^10.9.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"prettier": "^3.1.0",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.7.6",
		"tslib": "^2.6.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.0.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"cookie": "0.7.0"
